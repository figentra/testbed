{
  "name": "@figentra/testbed",
  "version": "0.1.2",
  "private": false,
  "description": "The testbed: disposable, image-built EC2 test boxes in two Auto Scaling groups, an EC2 Image Builder pipeline that bakes the job image and the box agent into an AMI, the grants that let a box read its job secrets from Infisical, and the `testbed` CLI that runs heavy checks on them; the plan is pure data, the Pulumi program only declares",
  "keywords": [
    "ami",
    "auto-scaling",
    "ci",
    "image-builder",
    "infrastructure",
    "pulumi",
    "test-boxes",
    "testbed"
  ],
  "homepage": "https://github.com/figentra/testbed/tree/main/packages/testbed#readme",
  "bugs": {
    "url": "https://github.com/figentra/testbed/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/testbed.git",
    "directory": "packages/testbed"
  },
  "bin": {
    "testbed": "./dist/cli/main.mjs"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "images",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*/index.ts"
    ],
    "#cli/*": [
      "./src/cli/*",
      "./src/cli/*.ts",
      "./src/cli/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://npm.stackra.figentra.com/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@pulumi/aws": "catalog:infra",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pulumi/pulumi": "catalog:infra",
    "@stackra/tsdown-config": "catalog:stackra",
    "@stackra/typescript-config": "catalog:stackra",
    "@stackra/vitest-config": "catalog:stackra",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "@pulumi/pulumi": "catalog:infra"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
