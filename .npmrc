# The @stackra scope (the shared presets) resolves from the Stackra registry only (ADR 0453); never npmjs.
@stackra:registry=https://npm.stackra.figentra.com/
# Figentra Flow (@figentra-oss/flow) resolves from the Figentra registry's open scope, read anonymously. Every other
# dependency comes from npmjs.
@figentra-oss:registry=https://npm.stackra.figentra.com/
