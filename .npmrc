# The @stackra scope (the shared presets) resolves from the Stackra registry only (ADR 0453); never npmjs.
@stackra:registry=https://registry.figentra.com/
# Figentra Flow (@figentra-oss/flow) resolves from the Figentra registry's open scope, read anonymously. Every other
# dependency comes from npmjs.
@figentra-oss:registry=https://registry.figentra.com/
# Every Figentra scope on the one registry (ADR 0453 as amended, STA-1733).
@stackra-pro:registry=https://registry.figentra.com/
@figentra:registry=https://registry.figentra.com/
