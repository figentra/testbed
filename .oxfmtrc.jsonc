// Testbed file contract:
// Purpose: oxfmt settings, matching figentra/stackra's line width, and the files that are never reformatted.
// Owner: release-operations · Secrets: forbidden
{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "ignorePatterns": [
    // hashed image inputs: their bytes set the image version, so a reformat forces an image rebuild (AGENTS.md)
    "packages/testbed/images/**",
    "packages/testbed/src/agent/testbed-agent.sh",
    "packages/testbed/src/core/constants/toolchain-pins.constant.ts",
    // generated by tools, never hand-formatted
    "pnpm-lock.yaml",
    "**/CHANGELOG.md",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    // skills are rendered by `fflow sync` or moved byte for byte; never formatted here
    ".agents/skills/**",
  ],
}
